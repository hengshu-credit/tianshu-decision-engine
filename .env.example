# 前后端会自动读取仓库根目录 .env；复制后替换为当前环境的独立强密码，请勿提交真实凭据。
# 生产环境应使用 Secret/KMS 或系统环境变量覆盖 .env 中的同名配置。
SERVER_PORT=8080
# npm run dev 的监听端口；生产前端端口由 Nginx 或容器映射配置。
VITE_PORT=9090
# 留空时 /api 自动代理到 http://localhost:${SERVER_PORT}。
VITE_DEV_PROXY=

MYSQL_ROOT_PASSWORD=replace-with-a-strong-mysql-password
MYSQL_DATABASE=rule_engine
# MySQL 连接参数统一使用 MYSQL_HOST/MYSQL_PORT：JAR 直接读取；外接数据库 Compose 填容器可达的远程地址；完整 Compose 会在容器内覆盖为 mysql:3306。
# JAR 连接本机数据库时填 127.0.0.1；外接 Compose 连接宿主机数据库时填 host.docker.internal 或实际地址。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
# 服务端启动时自动执行 classpath:sql/schema.sql；已有库可临时设为 never。
SPRING_SQL_INIT_MODE=always
# 外接数据库 Compose 使用同一组 MYSQL_HOST/MYSQL_PORT；在容器访问宿主机时将 MYSQL_HOST 改为 host.docker.internal 或实际地址。
REDIS_PASSWORD=replace-with-a-strong-redis-password
# Redis 连接参数统一使用 REDIS_HOST/REDIS_PORT；完整 Compose 会在容器内覆盖为 redis:6379。
REDIS_HOST=localhost
REDIS_PORT=6379

# rule-engine-server 使用的数据库账号建议单独创建并按最小权限授权。
MYSQL_USERNAME=rule_engine_app
MYSQL_PASSWORD=replace-with-a-strong-app-password

# 至少 32 个字符、非重复且仅属于当前环境。
RULE_AUTH_MASTER_KEY=replace-with-a-private-random-key-of-at-least-32-characters
RULE_AUTH_ACTIVE_KEY_ID=v2
# 仅升级旧部署时临时配置；完成全部历史凭据重置后移除。
RULE_AUTH_LEGACY_MASTER_KEY=
RULE_AUTH_LEGACY_V2_MASTER_KEY=

CONSOLE_USERNAME=admin
# 默认按 BCrypt 校验；这里填写 BCrypt 哈希，不填写明文密码。
CONSOLE_PASSWORD=$2a$10$12345678901234567890123456789012345678901234567890123
CONSOLE_PASSWORD_ENCODING=BCRYPT
CORS_ALLOWED_ORIGIN_PATTERNS=https://console.example.com
SESSION_COOKIE_SECURE=true

# Docker/Compose 部署：每套独立环境使用不同 DEPLOY_PROJECT；不要同时启动 full 与独立依赖 Compose。
DEPLOY_PROJECT=tianshu
# 留空自动使用 ${DEPLOY_PROJECT}-engine；迁移已有环境时保留原网络名。
ENGINE_NETWORK=
# 相对路径以 docker/ 中的 Compose 文件为基准；也可填写宿主机绝对路径。
RUNTIME_DIR=./runtime
FRONTEND_PORT=9090
# server API 通过 web 的 8080 入口对 runtime 和跨机器客户端提供服务。
# 本机 NPM 使用 127.0.0.1；需要其他机器直接用 IP:端口访问时改为 0.0.0.0，并由现有防火墙/安全组限制来源。
SERVER_PUBLIC_BIND_ADDRESS=127.0.0.1
SERVER_PUBLIC_PORT=8080
RUNTIME_HTTP_PORT=7070
RUNTIME_SDK_PORT=7071
MYSQL_HOST_PORT=3306
REDIS_HOST_PORT=6379
# Nginx Proxy Manager 负责 HTTPS 和公网反向代理；本项目不修改 Ubuntu 防火墙或现有端口规则。
# server/web/HTTP/SDK 共用 APP_BIND_ADDRESS；MySQL/Redis 单独允许宿主机外部连接，便于远程调试。
APP_BIND_ADDRESS=127.0.0.1
MYSQL_BIND_ADDRESS=0.0.0.0
REDIS_BIND_ADDRESS=0.0.0.0
# docker/docker-compose.yml 使用外部数据库时，直接修改 MYSQL_HOST/MYSQL_PORT、REDIS_HOST/REDIS_PORT。
# full Compose 使用内部 kafka:19092；外部 Compose/JAR 使用 KAFKA_BOOTSTRAP_SERVERS 指向外部 Broker，并配置可访问的 advertised.listeners。

# 容器资源和日志限制。
SERVER_JAVA_TOOL_OPTIONS=-Xms256m -Xmx768m -XX:MaxMetaspaceSize=256m -XX:MaxDirectMemorySize=256m -XX:ReservedCodeCacheSize=128m -XX:+ExitOnOutOfMemoryError -XX:+UseG1GC
RUNTIME_HTTP_JAVA_TOOL_OPTIONS=-Xms128m -Xmx512m -XX:MaxMetaspaceSize=128m -XX:MaxDirectMemorySize=128m -XX:ReservedCodeCacheSize=64m -XX:+ExitOnOutOfMemoryError
RUNTIME_SDK_JAVA_TOOL_OPTIONS=-Xms128m -Xmx768m -XX:MaxMetaspaceSize=160m -XX:MaxDirectMemorySize=160m -XX:ReservedCodeCacheSize=64m -XX:+ExitOnOutOfMemoryError
MYSQL_MAX_CONNECTIONS=300
MYSQL_BUFFER_POOL_SIZE=1G
REDIS_MAXMEMORY=512mb
SERVER_REPLICAS=2
KAFKA_IMAGE=apache/kafka:4.0.2
KAFKA_BIND_ADDRESS=0.0.0.0
KAFKA_HOST_PORT=9092
KAFKA_ADVERTISED_HOST=replace-with-kafka-public-host
KAFKA_USERNAME=tianshu
KAFKA_PASSWORD=replace-with-at-least-32-character-kafka-password
DOCKER_LOG_MAX_SIZE=20m
DOCKER_LOG_MAX_FILES=5
SERVER_LOG_LEVEL=INFO
RUNTIME_LOG_LEVEL=INFO

# 正式运行时服务必须填写客户端实际可访问的服务端地址：服务器 IP+端口，或 Nginx Proxy Manager 配置的域名。
# 示例：RUNTIME_RULE_SERVER_URL=http://192.168.1.10:8080 或 https://api.example.com
RUNTIME_RULE_SERVER_URL=http://192.168.1.10:8080
RUNTIME_PROJECT_ACCESS_TOKEN=replace-with-project-access-token
RUNTIME_ACCESS_TOKEN=replace-with-at-least-32-character-runtime-token
RUNTIME_RULE_PROJECT_CODE=replace-with-project-code
RUNTIME_RULE_PROJECT_ID=replace-with-project-id
HTTP_ACCESS_TOKEN=replace-with-at-least-32-character-http-runtime-token
SDK_ACCESS_TOKEN=replace-with-at-least-32-character-sdk-runtime-token
HTTP_RULE_ALLOWED_CODES=replace-with-published-rule-code
SDK_RULE_ALLOWED_CODES=replace-with-published-rule-code
RUNTIME_TRACE_ENABLED=true
RULE_HTTP_TIMEOUT_MS=30000
RUNTIME_CORS_ALLOWED_ORIGINS=https://hengshu-credit.github.io,http://localhost:*,http://127.0.0.1:*

# SDK 本地执行日志默认通过 HTTP 上报；显式选择 KAFKA 时填写容器可访问的 broker 地址。
SDK_LOG_REPORT_ENABLED=true
SDK_LOG_REPORT_TRANSPORT=HTTP
SDK_KAFKA_LOG_TOPIC=rule-execution-log
SDK_KAFKA_HTTP_FALLBACK_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=
# Kafka 服务端消费默认关闭；开启时填写真实项目主题到 project_id 的 JSON 映射。
RULE_KAFKA_ENABLED=false
RULE_KAFKA_GROUP_ID=rule-engine-server
KAFKA_SERVER_APPLICATION_JSON={}
# 示例：{"rule-engine":{"kafka":{"topic-projects":{"rule-execution-log-risk":1}}}}
KAFKA_SDK_APPLICATION_JSON={}
# 上述两个 JSON 分别传入 server/SDK 容器的 SPRING_APPLICATION_JSON，支持各自的 spring.kafka TLS/SASL 配置。
# .env 中未映射的 SPRING_KAFKA_* 不会自动进入 Compose 容器；证书挂载和 ACL 见 docs/kafka-execution-logs.md。

# 业务审计日志默认永久保存；只有总开关开启且对应天数大于 0 时才清理。
RULE_LOG_RETENTION_ENABLED=false
RULE_LOG_RETENTION_INTERVAL_MS=86400000
RULE_LOG_RETENTION_BATCH_SIZE=1000
RULE_LOG_RETENTION_MAX_BATCHES_PER_TABLE=10
RULE_LOG_RETENTION_QUERY_TIMEOUT_SECONDS=5
RULE_AUTH_ACCESS_LOG_RETENTION_DAYS=0
