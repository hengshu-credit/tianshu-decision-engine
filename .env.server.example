# 天枢服务端配置
# 全新体验环境：复制 .env.server.example 为 .env.server，并同时复制客户端示例；已有环境保留原配置与密钥。
# Maven/JAR 读取工作目录及上级目录的 .env.server；同名配置以当前目录为准，环境变量和启动参数优先。
# Vite 也读取 .env.server；不会把数据库、Redis 等凭据注入浏览器。不读取旧 .env 或 .env.server.local。
# Compose 使用 --env-file .env.server；合并客户端配置时先传 .env.client，后传 .env.server，同名项以后者为准。
# --env-file 只提供 Compose 插值，不会自动把所有参数传进容器；仅源码/JAR使用的项需通过 override 的 environment 显式传入。
# 快速开始：先用 mysql/redis Compose 启动全新依赖；首次在仓库根目录运行 mvn install -DskipTests。
# 编译后进入 rule-engine-server 执行 mvn spring-boot:run；前端在 rule-engine-web 执行 npm ci、npm run dev。
# 示例密码仅初始化新的数据目录；已有数据库必须填写实际账号密码，不能靠覆盖 env 修改已有账号。
# 体验结束转正式部署时，独立更换 MySQL/Redis/Kafka 密码、全局签名密钥对及 runtime 入口令牌。
# 格式：每行 KEY=value；普通地址、数字、布尔值、单行 JSON 和 JVM 参数无需外层引号，空值写 KEY=。
# 值包含 #、字面量 $ 或需要保留首尾空格时才用单引号；不要在值中写变量引用、跨行内容或 shell 命令。
# 单引号保护 Compose 的 $ 插值，也保护 Java/Node 的 # 注释解析；复杂值须核对各加载器解析结果。
# 两个 example 已生成一套配对的试运行凭据；这些值随仓库公开，仅用于本地体验，正式部署前必须修改。

# ---------- Compose 项目与镜像（不影响 Maven/JAR） ----------
# Compose 项目名；同一套部署的 mysql/redis/server 等命令使用相同项目名，-p 参数可覆盖。
DEPLOY_PROJECT=tianshu-server
# Docker 网络名；需要容器名称互访的服务应位于同一网络，不同环境使用不同名称。
ENGINE_NETWORK=tianshu-server-engine
# 部署产物目录，包含 server.jar、runtime.jar 和 dist/；相对路径以 Compose 文件所在目录解析。
RUNTIME_DIR=./runtime
# server/runtime 的 Java 运行镜像；须兼容 JDK 17。
JAVA_IMAGE=eclipse-temurin:17-jre-jammy
# 控制台与 API 代理使用的 Nginx 镜像。
NGINX_IMAGE=nginx:1.29.1-alpine

# ---------- 源码/JAR 与前端开发端口 ----------
# Maven/IDE/JAR 后端监听端口；Compose 内 server 固定为 8080，对外端口见 SERVER_PUBLIC_PORT。
SERVER_PORT=8080
# npm run dev 的前端端口；端口被占用时 Vite 直接报错，不自动换端口。
VITE_PORT=9090
# Vite /api 代理目标；留空时自动使用 http://localhost:SERVER_PORT。远程后端填写完整 HTTP(S) 地址。
VITE_DEV_PROXY=

# ---------- Compose 对外监听 ----------
# web/运行时宿主机绑定地址；127.0.0.1 仅本机，0.0.0.0 监听所有网卡；不控制 Vite 的监听地址。
APP_BIND_ADDRESS=0.0.0.0
# web 的宿主机端口，映射到容器 80；与 VITE_PORT 分属不同启动方式，同时运行时必须错开。
FRONTEND_PORT=9090
# API 代理的宿主机绑定地址；请求经 web 容器分发至 server 副本。
SERVER_PUBLIC_BIND_ADDRESS=0.0.0.0
# API 代理的宿主机端口，映射到 web 容器 8080；不直接发布各 server 副本端口。
SERVER_PUBLIC_PORT=8080
# server 副本数，默认 2；共享 MySQL、Redis 和鉴权主密钥，每个副本使用独立日志目录。
SERVER_REPLICAS=2

# ---------- MySQL ----------
# 应用连接地址：Docker Desktop 宿主机映射可用 host.docker.internal；远程库填写实际 IP/域名。
# 本机 127.0.0.1 仅在确认端口属于目标实例时使用，避免连到 WSL 中同端口的另一套数据库。
# 容器中的 localhost 指向容器自身；full 模式覆盖主机为 mysql，MYSQL_PORT 必须保持容器端口 3306。
MYSQL_HOST=host.docker.internal
# 应用连接端口；外接模式填写目标实例的可达端口，修改宿主机映射另见 MYSQL_HOST_PORT。
MYSQL_PORT=3306
# 管理数据库名；不存在时 JDBC 尝试创建，需要账号具备相应权限。
MYSQL_DATABASE=rule_engine
# 已有库填写实际应用账号；mysql/full Compose 仅在全新数据目录中初始化该账号。
MYSQL_USERNAME=rule_engine_app
# 与应用账号匹配的密码；修改此值不会自动修改已有 MySQL 账号的密码。
MYSQL_PASSWORD=5f7530533041f36a3e51a31f673c83c15a4a88a8419c33ec30aa7a91325a9a71
# mysql/full Compose 初始化 root 的密码；已有数据目录须与实际 root 密码匹配，健康检查也使用此值。
MYSQL_ROOT_PASSWORD=2559c81e521adaba05f66e41828b47e6e9db269a29d4314506a0b831c0fe0c3d
# mysql/full Compose 的数据库镜像；已有数据目录升级前需确认版本兼容性。
MYSQL_IMAGE=mysql:8.4.6
# mysql/full Compose 的监听地址，同时传给容器 mysqld 与宿主机映射；保持 0.0.0.0 供容器间连接。
MYSQL_BIND_ADDRESS=0.0.0.0
# MySQL 宿主机映射端口，容器内仍为 3306；full 模式改此项不应跟着改 MYSQL_PORT。
MYSQL_HOST_PORT=3306
# mysql/full Compose 的最大数据库连接数；按应用副本和连接池总量调整。
MYSQL_MAX_CONNECTIONS=300
# mysql/full Compose 的 InnoDB 缓冲池；需为其他 MySQL 内存留余量，当前容器内存上限为 1536M。
MYSQL_BUFFER_POOL_SIZE=1G
# 源码/JAR：是否允许管理库 JDBC 一次执行多条 SQL；默认 false，普通查询无需开启。
MYSQL_ALLOW_MULTI_QUERIES=false
# 启动时执行幂等 schema.sql：always 执行，never 跳过；只初始化结构和系统常量，不导入业务样例。
SPRING_SQL_INIT_MODE=always
# 源码/JAR：初始化脚本失败是否继续启动；保持 false，避免结构不完整却对外提供服务。
SPRING_SQL_INIT_CONTINUE_ON_ERROR=false
# 是否补齐可选内置变量和数据对象；仅插入缺失项，不覆盖现有内容，默认关闭。
RULE_ENGINE_INITIAL_DATA_ENABLED=false
# 上述可选初始数据的 SQL 位置；可用 classpath: 或 file:，容器使用外部文件时还需挂载。
RULE_ENGINE_INITIAL_DATA_LOCATION=classpath:sql/initial-data.sql

# ---------- Redis 与控制台会话 ----------
# 应用连接地址；必须与 .env.client 指向同一 Redis 实例，地址文本可因部署位置而不同。
# Docker Desktop 映射端口可用 host.docker.internal；full 模式覆盖主机为 redis，端口保持 6379。
REDIS_HOST=host.docker.internal
# 应用连接端口；外接模式用可达端口，宿主机映射由 REDIS_HOST_PORT 控制。
REDIS_PORT=6379
# Redis database 编号，server/SDK 必须一致；常规 Redis 默认提供 0-15，取决于实际服务配置。
REDIS_DATABASE=0
# 实际 Redis 密码；server/client 必须一致，redis/full Compose 也将其用作 requirepass。
REDIS_PASSWORD=c88ca5592174bf1b688f5f85387147679ee8dc51acf832580961e9f255c38b40
# redis/full Compose 的 Redis 镜像。
REDIS_IMAGE=redis:8.2.1
# Redis 宿主机映射的绑定地址；0.0.0.0 所有网卡，127.0.0.1 仅本机访问。
REDIS_BIND_ADDRESS=0.0.0.0
# Redis 宿主机映射端口，容器内仍为 6379；full 模式的 REDIS_PORT 保持 6379。
REDIS_HOST_PORT=6379
# Redis maxmemory，支持 mb/gb；新示例为 256mb，低于 Compose 的 384M 限额并预留开销。
# 已有环境保留原值；若仍为 512mb，重新部署时需降低此值或相应提高容器内存限额。
REDIS_MAXMEMORY=256mb
# 控制台会话键前缀；同一套 server 副本保持一致，不同环境使用不同前缀。
SESSION_REDIS_NAMESPACE=tianshu:session
# 源码/JAR：控制台 Redis 会话闲置超时；支持 s/m/h，例如 60m。
SESSION_TIMEOUT=60m

# ---------- 项目鉴权与全局签名 ----------
# 加密项目/数据源等凭据的主密钥，至少 32 字符且至少包含 8 种不同字符；所有 server 节点必须一致。
# 已有环境必须保留原值；直接更换会导致已有密文无法解密，不能用换密钥的方式重置控制台账号。
RULE_AUTH_MASTER_KEY=cd63d271c975b2475eb07f4c3dfd45de1af15be5b569482bfc1cd9f3cce2e0b3
# true 启用 Ed25519 全局访问，持有匹配私钥的客户端可访问全部已发布项目；false 使用各项目鉴权。
RULE_GLOBAL_ACCESS_ENABLED=true
# 全局签名密钥标识；必须与 .env.client 的 RULE_GLOBAL_KEY_ID 一致。
RULE_GLOBAL_ACCESS_KEY_ID=example-local
# Ed25519 公钥：X.509 DER 的单行 Base64；与客户端 PKCS#8 私钥配对，不使用 PEM 多行格式。
RULE_GLOBAL_ACCESS_PUBLIC_KEY=MCowBQYDK2VwAyEAZO+dFZJpOwB44YW6jiTryauJxkXmS5oDpZS56NHFCIQ=
# 全局签名时间窗口，单位秒，允许 1-86400；服务端与客户端时钟应同步。
RULE_GLOBAL_ACCESS_TIME_WINDOW_SECONDS=300

# ---------- 控制台注册、找回与邮件（源码/JAR；Compose 需显式传入） ----------
# 首次超管在页面初始化，不从 env 设置账号密码；此开关仅控制后续邮箱注册，仍需邮件配置完整。
CONSOLE_REGISTRATION_ENABLED=false
# 是否允许邮箱找回密码；邮件未配置时入口不可用，不影响服务器一次性恢复码流程。
CONSOLE_PASSWORD_RECOVERY_ENABLED=true
# 发件邮箱地址；留空表示尚未配置，须符合 SMTP 服务的发件人要求。
CONSOLE_MAIL_FROM=
# 邮件中的控制台链接根地址，例如 https://engine.example.com；填写可信、用户可访问的地址。
CONSOLE_MAIL_BASE_URL=
# 注册验证链接有效期，单位分钟。
CONSOLE_VERIFICATION_TTL_MINUTES=30
# 密码重置链接有效期，单位分钟。
CONSOLE_PASSWORD_RESET_TTL_MINUTES=30
# SMTP 主机；留空时不启用邮件发送。
CONSOLE_SMTP_HOST=
# SMTP 端口；587 通常配合 STARTTLS，按邮件服务商实际配置填写。
CONSOLE_SMTP_PORT=587
# SMTP 登录账号；通常是完整邮箱地址。
CONSOLE_SMTP_USERNAME=
# SMTP 密码或服务商提供的应用授权码；不是控制台登录密码。
CONSOLE_SMTP_PASSWORD=
# 是否启用 SMTP 用户名/密码认证。
CONSOLE_SMTP_AUTH=true
# 是否启用 SMTP STARTTLS；此开关不等同于 465 端口的隐式 SSL。
CONSOLE_SMTP_STARTTLS=true
# 控制台 API 允许的来源模式，多个用英文逗号分隔；* 允许全部来源，可改为实际控制台地址。
CORS_ALLOWED_ORIGIN_PATTERNS=*

# ---------- Kafka（仅启用 Kafka 执行日志时使用） ----------
# Compose 的 broker 入口；full 模式使用 kafka:19092，外接模式填写服务端/SDK 均可达的地址。
# 源码/JAR 的 server 需另传 spring.kafka.bootstrap-servers（或 SPRING_KAFKA_BOOTSTRAP_SERVERS）。
KAFKA_BOOTSTRAP_SERVERS=kafka:19092
# 服务端是否消费 Kafka 执行日志；true 时还必须配置 broker、认证以及主题到真实项目 ID 的绑定。
RULE_KAFKA_ENABLED=false
# 同一套 server 副本使用同一消费组；独立环境使用不同组名。
RULE_KAFKA_GROUP_ID=rule-engine-server
# 仅 Compose：映射为 SPRING_APPLICATION_JSON，配置 Kafka SASL 与 rule-engine.kafka.topic-projects。
# 使用单行 JSON；源码/JAR 需通过 SPRING_APPLICATION_JSON 环境变量或对应 Spring 参数传入，详见 docs/kafka-execution-logs.md。
KAFKA_SERVER_APPLICATION_JSON={}
# kafka/full Compose 的 Kafka 镜像。
KAFKA_IMAGE=apache/kafka:4.0.2
# Kafka 对外端口的宿主机绑定地址。
KAFKA_BIND_ADDRESS=0.0.0.0
# Kafka 对外映射端口；内部 broker 入口为 kafka:19092。
KAFKA_HOST_PORT=9092
# 广播给外部客户端的主机名/IP，不能填 0.0.0.0；跨机器访问须改为实际可达地址。
KAFKA_ADVERTISED_HOST=127.0.0.1
# kafka/full Compose 的 SASL 用户名；应用侧 SASL 配置需与其一致。
KAFKA_USERNAME=tianshu
# kafka/full Compose 的 SASL 密码，至少 32 位，仅限英文字母、数字、下划线和连字符；应用侧使用相同值。
KAFKA_PASSWORD=f79c958b0967fc5325ce96f8b2b7ad7c5bee9d8bd7fecf6e48e59d6c8c24813e

# ---------- Compose JVM 与容器日志 ----------
# 仅 Compose：传给 server 的 JAVA_TOOL_OPTIONS；源码/JAR 需在 JVM 启动参数中配置，内部空格无需外层引号。
SERVER_JAVA_TOOL_OPTIONS=-Xms256m -Xmx768m -XX:MaxMetaspaceSize=256m -XX:MaxDirectMemorySize=256m -XX:+ExitOnOutOfMemoryError
# Docker stdout 日志单文件大小，如 10m；与数据库中的业务日志留存策略无关。
DOCKER_LOG_MAX_SIZE=10m
# Docker stdout 轮转文件保留数。
DOCKER_LOG_MAX_FILES=3
# 仅 Compose：根日志级别 TRACE/DEBUG/INFO/WARN/ERROR；源码/JAR 使用 logging.level.root 参数。
SERVER_LOG_LEVEL=WARN
# Compose 优雅停机时每个生命周期阶段等待时间；须小于容器 stop_grace_period（当前 180s）。
SHUTDOWN_TIMEOUT=120s

# ---------- 执行、模型与追踪 ----------
# 持久化 trace 最大字节数；0 不限制，正数截断存储副本，不改变请求返回的完整 trace。
RULE_TRACE_MAX_PERSIST_BYTES=0
# 以下源码/JAR 参数，Compose 如需覆盖默认值，应在 server.environment 中显式传入。
# 持久化 trace 的脱敏 JSONPath，英文逗号分隔；例如 $.input.idCard，含字面量 $ 时使用单引号。
RULE_TRACE_MASK_PATHS=
# 变量来源并发解析的工作线程数。
SOURCE_RESOLUTION_PARALLELISM=4
# 全部数据库数据源共享的并发查询上限；超过上限返回可重试的容量错误。
RULE_DATABASE_MAX_CONCURRENT_QUERIES=128
# 是否记录外数等运行调用的请求/响应正文；false 仍保留调用状态等元数据。
RULE_RUNTIME_LOG_CONTENT_ENABLED=true
# 调用日志单字段内容最大字节数；0 不限制。
RULE_RUNTIME_LOG_MAX_FIELD_BYTES=0
# ONNX 会话缓存条目上限；限制会话数量，不代表 native 内存或显存大小。
ONNX_SESSION_CACHE_MAX_ENTRIES=16
# 单个模型文件上限，单位字节，默认 256 MiB；上传还受 HTTP multipart 限制。
RULE_MODEL_MAX_FILE_SIZE_BYTES=268435456
# 模型测试参数上限，单位字节，默认 1 MiB。
RULE_MODEL_MAX_TEST_PARAMS_BYTES=1048576
# 模型执行工作线程数。
RULE_MODEL_EXECUTION_PARALLELISM=8
# 模型执行等待队列容量；与线程数及下游资源一起评估。
RULE_MODEL_EXECUTION_QUEUE_CAPACITY=256
# 单个模型的并发执行上限，超过后返回 503/THROTTLED。
RULE_MODEL_MAX_CONCURRENT_PER_MODEL=8
# 运维监控中的实例标识；留空使用 JVM 进程标识，多副本定制时每个实例应不同。
RULE_ENGINE_INSTANCE_ID=

# ---------- 执行持久化与恢复日志 ----------
# 本地写前日志开关；数据库 outbox 不可写时作为兜底，关闭后故障恢复能力会减弱。
RULE_EXECUTION_PERSISTENCE_JOURNAL_ENABLED=true
# 以下源码/JAR 参数；Compose 已为恢复日志挂载持久卷，并按容器 HOSTNAME 隔离目录。
# 异步执行持久化队列容量，单位条。
RULE_EXECUTION_PERSISTENCE_QUEUE_CAPACITY=5000
# 本地写前日志目录；相对路径以服务工作目录为准，多个进程不能共享同一可写目录。
RULE_EXECUTION_PERSISTENCE_JOURNAL_DIR=./logs/execution-persistence-journal
# 单条恢复记录上限，单位 UTF-8 字节，包含封装信息和行尾换行，默认 10 MiB。
RULE_EXECUTION_PERSISTENCE_JOURNAL_MAX_ENTRY_BYTES=10485760
# 恢复重放间隔，单位毫秒。
RULE_EXECUTION_PERSISTENCE_JOURNAL_REPLAY_DELAY_MS=5000
# 每批恢复重放的最大记录数。
RULE_EXECUTION_PERSISTENCE_JOURNAL_REPLAY_BATCH_SIZE=1000
# 名单动作恢复日志目录；独立于执行日志目录。
RULE_LIST_ACTION_JOURNAL_DIR=./logs/list-action-journal
# 是否扫描父目录下其他实例留下的名单动作日志；本机默认关闭，Compose 已按部署目录启用。
RULE_LIST_ACTION_JOURNAL_SCAN_PARENT=false

# ---------- 业务日志留存（源码/JAR；Compose 需显式传入） ----------
# 是否执行定期清理；默认 false，保持业务审计记录。启用前按业务要求设置保留天数。
RULE_LOG_RETENTION_ENABLED=false
# 清理间隔，单位毫秒，允许 60000-604800000；默认每天一次。
RULE_LOG_RETENTION_INTERVAL_MS=86400000
# 每批删除上限，允许 1-10000 条。
RULE_LOG_RETENTION_BATCH_SIZE=1000
# 每轮每张表最多处理批次，允许 1-100。
RULE_LOG_RETENTION_MAX_BATCHES_PER_TABLE=10
# 单次清理 SQL 超时，单位秒，允许 1-30。
RULE_LOG_RETENTION_QUERY_TIMEOUT_SECONDS=5
# 项目鉴权访问日志保留天数，0 表示永久保留；仅在清理开关启用时生效。
RULE_AUTH_ACCESS_LOG_RETENTION_DAYS=0
