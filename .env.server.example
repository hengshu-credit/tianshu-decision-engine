# 天枢服务端初始部署配置
# 用法：复制为 .env.server，再按“必须修改”说明检查；不要把生产真实密钥提交到 Git。
# 本文件中的随机值只作为本次初始模板值，生产部署前请轮换数据库、Redis、Kafka、鉴权和控制台凭证。

# ---------- Compose 项目与镜像 ----------
# 作用：Compose 项目名；可选：同一台机器上的每套环境使用不同名称。
DEPLOY_PROJECT=tianshu-server
# 作用：Compose 网络名；可选：自定义 Docker 网络名。
ENGINE_NETWORK=tianshu-server-engine
# 作用：server.jar/dist 所在目录；通常不改。
RUNTIME_DIR=./runtime
# 作用：server 运行时镜像；可选：兼容 JDK 17 的 JRE 镜像。
JAVA_IMAGE=eclipse-temurin:17-jre-jammy
# 作用：控制台静态站点镜像；可选：兼容 Nginx 镜像。
NGINX_IMAGE=nginx:1.29.1-alpine

# ---------- 对外监听 ----------
# 作用：web 绑定地址；可选：127.0.0.1（仅本机/NPM 内网访问）或 0.0.0.0（公网/局域网访问）。
APP_BIND_ADDRESS=0.0.0.0
# 作用：控制台宿主机端口；必须改为未占用端口，例如 28085。
FRONTEND_PORT=9090
# 作用：server 直连监听地址；可选：127.0.0.1 或 0.0.0.0。
SERVER_PUBLIC_BIND_ADDRESS=0.0.0.0
# 作用：server 宿主机端口；必须改为未占用端口，例如 28086。
SERVER_PUBLIC_PORT=8080
# 作用：server 副本数；可选：1、2、3；默认 2。
SERVER_REPLICAS=2

# ---------- MySQL ----------
# 外接数据库模式：MYSQL_HOST/MYSQL_PORT 必须改成容器可访问的数据库地址和端口。
# full 模式：server 会自动使用 mysql:3306，下面的账号密码用于 MySQL 容器初始化。
# 必须修改：外接 MySQL 的容器可达地址；Linux 同机可用 host.docker.internal 或服务器内网 IP。
MYSQL_HOST=host.docker.internal
# 必须修改：外接 MySQL 宿主机映射端口；full 模式保持默认即可。
MYSQL_PORT=3306
# 作用：目标数据库名；不存在时 JDBC 会尝试创建。
MYSQL_DATABASE=rule_engine
# 必须修改（外接模式）：已有 MySQL 应用账号；full 模式可使用此初始账号。
MYSQL_USERNAME=rule_engine_app
# 必须修改（外接模式）：与 MYSQL_USERNAME 匹配的密码。
MYSQL_PASSWORD=gDCh5IjrGoWRMNsBSQEfYzr2Q2KOWikZ
# full 模式初始化 root 密码；外接模式不由本 Compose 使用，建议仍替换。
MYSQL_ROOT_PASSWORD=P3x9YIqlPmq9eRKXpwmTWTJ0kHZzoEjWAtdyriQ8
# 作用：full/mysql Compose 的 MySQL 镜像。
MYSQL_IMAGE=mysql:8.4.6
# 作用：MySQL 监听地址；远程调试可用 0.0.0.0，生产应由防火墙/安全组限制来源。
MYSQL_BIND_ADDRESS=0.0.0.0
# 作用：MySQL 宿主机暴露端口；必须改为未占用端口。
MYSQL_HOST_PORT=3306
# 作用：MySQL 最大连接数；可选：100-1000，按内存和业务并发调整。
MYSQL_MAX_CONNECTIONS=300
# 作用：InnoDB 缓冲池；可选：512M、1G、2G，8GB 主机建议不超过 1G-2G。
MYSQL_BUFFER_POOL_SIZE=1G
# 作用：启动执行幂等 schema.sql；可选：always、never；首次部署保持 always。
SPRING_SQL_INIT_MODE=always
# 可选：启动时补齐内置变量和数据对象；仅插入缺失编码，不覆盖已有修改。
RULE_ENGINE_INITIAL_DATA_ENABLED=false
# 可选：自定义初始 SQL 资源；默认使用 server 内置的 classpath:sql/initial-data.sql。
RULE_ENGINE_INITIAL_DATA_LOCATION=classpath:sql/initial-data.sql

# ---------- Redis ----------
# 必须修改（外接模式）：Redis 容器可达地址；full 模式自动使用 redis。
REDIS_HOST=host.docker.internal
# 必须修改（外接模式）：Redis 宿主机映射端口。
REDIS_PORT=6379
# 作用：Redis DB 编号；可选：0-15，server/client 必须一致。
REDIS_DATABASE=0
# 必须修改（外接模式）：已有 Redis 密码；full 模式用于 Redis 容器启动。
REDIS_PASSWORD=SWko7Gb6GWk3P8Plfwct4ulFP1TAdMCMFaJGdFsd
# 作用：Redis 镜像。
REDIS_IMAGE=redis:8.2.1
# 作用：Redis 监听地址；远程调试需防火墙限制来源。
REDIS_BIND_ADDRESS=0.0.0.0
# 作用：Redis 宿主机暴露端口；必须改为未占用端口。
REDIS_HOST_PORT=6379
# 作用：Redis 内存上限；可选：256mb、512mb、1gb。
REDIS_MAXMEMORY=512mb
# 作用：Spring Session 前缀；多套环境必须不同。
SESSION_REDIS_NAMESPACE=tianshu:session

# ---------- 项目鉴权与控制台 ----------
# 必须修改：至少 32 字符随机密钥；所有 server 节点必须一致。
RULE_AUTH_MASTER_KEY=fa752e5a292710c226236f2edffc02c019810695ae6f8d46e100ff358ae4a80a
# 作用：当前鉴权密钥版本；轮换时使用新的 key ID。
RULE_AUTH_ACTIVE_KEY_ID=v2
# 默认启用 Ed25519 全局规则访问，与 .env.client.example 中的私钥配对；生产请生成并替换为自己的密钥对。
RULE_GLOBAL_ACCESS_ENABLED=true
RULE_GLOBAL_ACCESS_KEY_ID=default
RULE_GLOBAL_ACCESS_PUBLIC_KEY=MCowBQYDK2VwAyEAbh/u9s5v+lj0UO24rT/5QUToHigKO4PzWyy4BjXKvek=
RULE_GLOBAL_ACCESS_TIME_WINDOW_SECONDS=300
# 必须修改：首次登录控制台用户名。
CONSOLE_USERNAME=admin
# 初始明文密码（只用于生成下面的 BCrypt）：Tianshu-pbILJiC7iuxtK5Sx
# 必须修改：BCrypt 密文；不要填明文，生产请重新生成。
CONSOLE_PASSWORD='$2b$10$JS2iYtH/EZIXNAbCRIuEPuQEQJLiSz1R85wf4ZoPZcMu1DbcPy..6'
# 可选：BCRYPT（生产推荐）或 PLAIN（仅临时调试）。
CONSOLE_PASSWORD_ENCODING=BCRYPT
# 可选：启用控制台邮箱注册和密码找回；必须同时配置 SMTP 与发件人。
CONSOLE_REGISTRATION_ENABLED=false
CONSOLE_PASSWORD_RECOVERY_ENABLED=true
# 仅在存量超级管理员没有恢复邮箱时临时启用；使用 Secret 注入随机密钥，恢复后立即关闭并轮换。
CONSOLE_BREAK_GLASS_RECOVERY_ENABLED=false
CONSOLE_BREAK_GLASS_RECOVERY_KEY=
CONSOLE_MAIL_FROM=
CONSOLE_MAIL_BASE_URL=
CONSOLE_VERIFICATION_TTL_MINUTES=30
CONSOLE_PASSWORD_RESET_TTL_MINUTES=30
CONSOLE_SMTP_HOST=
CONSOLE_SMTP_PORT=587
CONSOLE_SMTP_USERNAME=
CONSOLE_SMTP_PASSWORD=
CONSOLE_SMTP_AUTH=true
CONSOLE_SMTP_STARTTLS=true
# 默认允许所有来源，便于 IP+端口、域名和 NPM 调试；生产建议改为实际域名/IP来源，多个用逗号分隔。
CORS_ALLOWED_ORIGIN_PATTERNS=*

# ---------- Kafka ----------
# full 模式默认值；外接 Kafka 必须改成客户端可达 IP:端口。
KAFKA_BOOTSTRAP_SERVERS=kafka:19092
# 可选：true/false；是否启用服务端 Kafka 执行日志消费。
RULE_KAFKA_ENABLED=false
# 作用：Kafka 消费组名；多套环境必须不同。
RULE_KAFKA_GROUP_ID=rule-engine-server
# 可选：服务端 Spring Kafka JSON 配置；无额外配置保持 {}。
KAFKA_SERVER_APPLICATION_JSON={}
# 作用：Kafka 镜像。
KAFKA_IMAGE=apache/kafka:4.0.2
# 作用：Kafka 外部监听绑定地址。
KAFKA_BIND_ADDRESS=0.0.0.0
# 必须修改：Kafka 宿主机端口；例如 29092。
KAFKA_HOST_PORT=9092
# 必须修改：外部客户端实际访问的 IP/域名。
KAFKA_ADVERTISED_HOST=127.0.0.1
# 作用：Kafka SASL 用户名；外接 Kafka 时改为实际账号。
KAFKA_USERNAME=tianshu
# 必须修改：至少 32 位安全字符；外接 Kafka 时改为实际密码。
KAFKA_PASSWORD=jt2eBcQxG5FsNxYlWjst8WJeplwpAEp21qvVQeJb

# ---------- 日志、trace 与资源 ----------
# 作用：server JVM 资源上限。
SERVER_JAVA_TOOL_OPTIONS=-Xms256m -Xmx768m -XX:MaxMetaspaceSize=256m -XX:MaxDirectMemorySize=256m -XX:+ExitOnOutOfMemoryError
# 作用：Docker stdout 单文件轮转大小；可选：5m、10m、20m。
DOCKER_LOG_MAX_SIZE=10m
# 作用：Docker stdout 保留文件数；可选：2-10。
DOCKER_LOG_MAX_FILES=3
# 作用：server 日志级别；可选：ERROR、WARN、INFO、DEBUG，生产建议 WARN。
SERVER_LOG_LEVEL=WARN
# 作用：持久化 trace 大小上限，单位是字节（Bytes）；0 表示不限制，正数表示截断上限。
RULE_TRACE_MAX_PERSIST_BYTES=0
# 作用：单个模型文件最大字节数；超过后拒绝上传、替换或样例解析。
RULE_MODEL_MAX_FILE_SIZE_BYTES=268435456
# 作用：模型测试参数 JSON 最大字节数；超过后拒绝保存或执行。
RULE_MODEL_MAX_TEST_PARAMS_BYTES=1048576
# 作用：模型执行线程数与排队容量；按 CPU、ONNX 会话和下游资源容量调整。
RULE_MODEL_EXECUTION_PARALLELISM=8
RULE_MODEL_EXECUTION_QUEUE_CAPACITY=256
# 作用：单个模型同时执行的上限，超过后返回 503 并标记 THROTTLED。
RULE_MODEL_MAX_CONCURRENT_PER_MODEL=8
# 作用：数据库故障时保留恢复 journal；可选：true/false，关闭会降低磁盘占用但可能丢恢复能力。
RULE_EXECUTION_PERSISTENCE_JOURNAL_ENABLED=true
# 作用：容器停止时，Spring 每个生命周期阶段等待正在处理的请求/队列完成的最长时间；可选：30s-300s。
SHUTDOWN_TIMEOUT=120s
