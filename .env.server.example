# 服务端部署配置：server 多节点、web、控制台、MySQL/Redis/Kafka 连接。
# 复制为 .env.server；不要把真实密码提交到 Git。

DEPLOY_PROJECT=tianshu-server
ENGINE_NETWORK=tianshu-server-engine
RUNTIME_DIR=./runtime

APP_BIND_ADDRESS=0.0.0.0
FRONTEND_PORT=9090
SERVER_PUBLIC_BIND_ADDRESS=0.0.0.0
SERVER_PUBLIC_PORT=8080
SERVER_REPLICAS=2

# 复用服务器现有 MySQL/Redis 时填写容器可访问的 IP 和宿主机映射端口。
MYSQL_HOST=192.168.1.10
MYSQL_PORT=23306
MYSQL_DATABASE=rule_engine
MYSQL_USERNAME=rule_engine_app
MYSQL_PASSWORD=replace-with-existing-mysql-app-password
# 首次部署目标库不存在时，账号需要 CREATE DATABASE 权限；已有库可使用最小建表/变更权限。
# full Compose 模式才使用；外接数据库 server 模式不会读取这些容器初始化参数。
MYSQL_ROOT_PASSWORD=replace-with-strong-mysql-root-password
MYSQL_IMAGE=mysql:8.4.6
MYSQL_BIND_ADDRESS=0.0.0.0
MYSQL_HOST_PORT=3306
SPRING_SQL_INIT_MODE=always

REDIS_HOST=192.168.1.10
REDIS_PORT=26379
REDIS_DATABASE=0
REDIS_PASSWORD=replace-with-existing-redis-password
REDIS_IMAGE=redis:8.2.1
REDIS_BIND_ADDRESS=0.0.0.0
REDIS_HOST_PORT=6379

RULE_AUTH_MASTER_KEY=replace-with-at-least-32-character-private-key
RULE_AUTH_ACTIVE_KEY_ID=v2

CONSOLE_USERNAME=admin
CONSOLE_PASSWORD=replace-with-bcrypt-password-hash
CONSOLE_PASSWORD_ENCODING=BCRYPT
CORS_ALLOWED_ORIGIN_PATTERNS=https://console.example.com

# server 与 Kafka 使用同一 Docker 网络时填 kafka:19092；外部 Kafka 填客户端可达的 IP:端口。
KAFKA_BOOTSTRAP_SERVERS=kafka:19092
RULE_KAFKA_ENABLED=false
RULE_KAFKA_GROUP_ID=rule-engine-server
KAFKA_SERVER_APPLICATION_JSON={}

KAFKA_IMAGE=apache/kafka:4.0.2
KAFKA_BIND_ADDRESS=0.0.0.0
KAFKA_HOST_PORT=9092
KAFKA_ADVERTISED_HOST=replace-with-server-ip-or-kafka-host
KAFKA_USERNAME=tianshu
KAFKA_PASSWORD=replace-with-at-least-32-character-kafka-password

MYSQL_MAX_CONNECTIONS=300
MYSQL_BUFFER_POOL_SIZE=1G
REDIS_MAXMEMORY=512mb
SERVER_JAVA_TOOL_OPTIONS=-Xms256m -Xmx768m -XX:MaxMetaspaceSize=256m -XX:MaxDirectMemorySize=256m -XX:+ExitOnOutOfMemoryError
DOCKER_LOG_MAX_SIZE=20m
DOCKER_LOG_MAX_FILES=5
SERVER_LOG_LEVEL=INFO
SHUTDOWN_TIMEOUT=120s
