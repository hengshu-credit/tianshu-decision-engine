 export const defaultSqlQuery = (mode: SqlMode, targets: string[], isElasticsearch = true) => {
-  const from = mode === 'esql' || !isElasticsearch ? targets.join(',') : `"${targets.join(',')}"`
+  const selected = targets.map(target => target.trim()).filter(target => target && target !== '*')
+  if (!selected.length) return ''
+  const from = mode === 'esql' || !isElasticsearch ? selected.join(',') : `"${selected.join(',')}"`
   return mode === 'esql' ? `FROM ${from}\n| LIMIT 100` : `SELECT *\nFROM ${from}\nLIMIT 100`
 }
+
+// Recognize only the empty templates persisted by older builds. Keep hand-written
+// SQL and ES|QL (including SELECT without FROM and ROW) exactly as entered.
+export const sqlDraftForTargets = (mode: SqlMode, draft: string, targets: string[], previous: string[], es: boolean) => {
+  const legacy = mode === 'sql' ? `SELECT *\nFROM ${es ? '""' : ''}\nLIMIT 100` : 'FROM \n| LIMIT 100'
+  return !draft.trim() || draft === legacy || draft === defaultSqlQuery(mode, previous, es)
+    ? defaultSqlQuery(mode, targets, es)
+    : draft
+}
