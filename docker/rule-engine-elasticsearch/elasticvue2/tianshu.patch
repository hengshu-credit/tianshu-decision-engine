+// Tianshu serves the UI and its authenticated ES proxy under the same base path.
+export const importTianshuCluster = () => {
+  const base = buildConfig.router.base
+  const uri = new URL(base + 'backend/', window.location.origin).href
+  const previous = loadConnectionState()
+  const saved = previous?.clusters ?? []
+  const managed = saved.find(cluster => cluster.predefined && cluster.uri === uri)
+  const cluster = buildPredefinedCluster({
+    name: '天枢 Elasticsearch',
+    uri,
+    username: 'tianshu_reader',
+    secretStorage: SecretStorage.session
+  }, managed)
+  const entry = [base.slice(0, -1), base, base + 'welcome'].includes(window.location.pathname)
+  const state: ConnectionState = {
+    clusters: managed ? saved.map(item => item.id === managed.id ? cluster : item) : [...saved, cluster],
+    activeClusterId: entry ? cluster.id : previous?.activeClusterId ?? cluster.id
+  }
+  localStorage.setItem('connection', JSON.stringify(state))
 }

