# 客户端 runtime 部署配置：HTTP runtime 和 SDK runtime。
# 复制为 .env.client；不要把真实令牌提交到 Git。

DEPLOY_PROJECT=tianshu-client
ENGINE_NETWORK=tianshu-client-engine
RUNTIME_DIR=./runtime

APP_BIND_ADDRESS=0.0.0.0
RUNTIME_HTTP_PORT=7070
RUNTIME_SDK_PORT=7071

# 填服务端 IP+端口，或 Nginx Proxy Manager 提供的 HTTPS 域名。
RUNTIME_RULE_SERVER_URL=https://engine-api.example.com
RUNTIME_PROJECT_ACCESS_TOKEN=replace-with-project-access-token-from-server
RUNTIME_RULE_PROJECT_CODE=replace-with-project-code
RUNTIME_RULE_PROJECT_ID=replace-with-project-id

HTTP_ACCESS_TOKEN=replace-with-at-least-32-character-http-runtime-token
SDK_ACCESS_TOKEN=replace-with-at-least-32-character-sdk-runtime-token
HTTP_RULE_ALLOWED_CODES=replace-with-published-rule-code
SDK_RULE_ALLOWED_CODES=replace-with-published-rule-code
RUNTIME_TRACE_ENABLED=false
RULE_HTTP_TIMEOUT_MS=30000
RUNTIME_CORS_ALLOWED_ORIGINS=https://console.example.com

# SDK runtime 必须连接与 server 共用的 Redis，用于规则/函数变更推送。
REDIS_HOST=192.168.1.10
REDIS_PORT=26379
REDIS_DATABASE=0
REDIS_PASSWORD=replace-with-existing-redis-password

SDK_CACHE_MAX_SIZE=1000
SDK_LOG_REPORT_ENABLED=true
SDK_LOG_REPORT_TRANSPORT=HTTP
SDK_KAFKA_LOG_TOPIC=rule-execution-log
SDK_KAFKA_HTTP_FALLBACK_ENABLED=true
# SDK_LOG_REPORT_TRANSPORT=KAFKA 时填写客户端可达的 Kafka 地址和 SASL/TLS JSON。
KAFKA_BOOTSTRAP_SERVERS=192.168.1.10:9092
KAFKA_SDK_APPLICATION_JSON={}

RUNTIME_HTTP_JAVA_TOOL_OPTIONS=-Xms128m -Xmx512m -XX:MaxMetaspaceSize=128m -XX:MaxDirectMemorySize=128m -XX:+ExitOnOutOfMemoryError
RUNTIME_SDK_JAVA_TOOL_OPTIONS=-Xms128m -Xmx768m -XX:MaxMetaspaceSize=160m -XX:MaxDirectMemorySize=160m -XX:+ExitOnOutOfMemoryError
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILES=3
RUNTIME_LOG_LEVEL=WARN
SHUTDOWN_TIMEOUT=120s
