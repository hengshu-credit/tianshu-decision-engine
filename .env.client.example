# 天枢客户端 runtime 初始部署配置
# 用法：复制为 .env.client，再按“必须修改”说明检查；不要把真实令牌提交到 Git。
# HTTP/SDK runtime 可部署在服务端或其他机器；RULE_SERVER_URL、Redis 和项目令牌必须与服务端匹配。

# ---------- Compose 项目与镜像 ----------
# 作用：Compose 项目名；多套客户端环境使用不同名称。
DEPLOY_PROJECT=tianshu-client
# 作用：Compose 网络名；通常不改。
ENGINE_NETWORK=tianshu-client-engine
# 作用：runtime.jar 所在目录；通常不改。
RUNTIME_DIR=./runtime
# 作用：runtime 镜像；可选：兼容 JDK 17 的 JRE 镜像。
JAVA_IMAGE=eclipse-temurin:17-jre-jammy

# ---------- 对外监听 ----------
# 作用：runtime 绑定地址；公网部署可用 0.0.0.0，内网部署可用 127.0.0.1。
APP_BIND_ADDRESS=0.0.0.0
# 作用：HTTP runtime 宿主机端口；必须改为未占用端口。
RUNTIME_HTTP_PORT=7070
# 作用：SDK runtime 宿主机端口；必须改为未占用端口。
RUNTIME_SDK_PORT=7071

# ---------- 服务端与项目凭证 ----------
# 必须修改：服务端 IP+端口或 NPM HTTPS 域名，例如 https://engine.example.com。
RUNTIME_RULE_SERVER_URL=http://127.0.0.1:8080
# 默认使用服务端 Ed25519 全局鉴权，启动后同步全部已发布项目规则；私钥必须与 .env.server 的公钥配对。
RUNTIME_PROJECT_ACCESS_TOKEN=
RULE_AUTH_TYPE=GLOBAL_KEY
RULE_GLOBAL_KEY_ID=default
RULE_GLOBAL_PRIVATE_KEY=MC4CAQAwBQYDK2VwBCIEIEe+3OmcK4sx0vRkf9m+lFi8Iq/GraJpIASOaJmW8qcQ
# 项目模式才填写以下三项；GLOBAL_KEY 全局模式保持为空。
RUNTIME_RULE_PROJECT_CODE=
RUNTIME_RULE_PROJECT_ID=
# 必须修改：HTTP runtime 对外访问令牌，业务调用方必须使用相同值。
HTTP_ACCESS_TOKEN=SDZf85eeFVLOAi7J5Lj87IkI85plC0gwRwN6iGTU
# 必须修改：SDK runtime 对外访问令牌，业务调用方必须使用相同值。
SDK_ACCESS_TOKEN=vLykfWkmaX8GQRpR0Ll0Yei4xQA5JFhhbSaMe0X8
# GLOBAL_KEY 全局模式留空；项目模式必须填写已发布规则编码，多个编码用逗号分隔。
HTTP_RULE_ALLOWED_CODES=
SDK_RULE_ALLOWED_CODES=
# 作用：客户端执行 trace；可选：false（生产默认）或 true（排障/审计）。
RUNTIME_TRACE_ENABLED=false
# 作用：调用服务端超时毫秒数；可选：1000-120000。
RULE_HTTP_TIMEOUT_MS=30000
# 必须修改：允许调用 runtime 的来源，多个用逗号分隔。
RUNTIME_CORS_ALLOWED_ORIGINS=http://localhost:9090

# ---------- Redis：必须与 server 使用同一实例 ----------
# 必须修改：服务端 Redis 的客户端可达地址；不能填客户端容器内 localhost。
REDIS_HOST=127.0.0.1
# 必须修改：Redis 宿主机映射端口。
REDIS_PORT=6379
# 必须修改：与 server 一致，通常为 0。
REDIS_DATABASE=0
# 必须修改：与 server Redis 密码一致；外接环境不能直接使用本文件随机值。
REDIS_PASSWORD=SWko7Gb6GWk3P8Plfwct4ulFP1TAdMCMFaJGdFsd

# ---------- SDK 缓存、日志上报与 Kafka ----------
# 作用：SDK 本地规则缓存条数上限；可选：100-10000。
SDK_CACHE_MAX_SIZE=1000
# 可选：true/false；是否上报 SDK 执行日志。
SDK_LOG_REPORT_ENABLED=true
# 可选：HTTP 或 KAFKA；生产默认 HTTP。
SDK_LOG_REPORT_TRANSPORT=HTTP
# 作用：Kafka 执行日志主题；使用 KAFKA 时必须存在并有权限。
SDK_KAFKA_LOG_TOPIC=rule-execution-log
# 可选：true/false；Kafka 失败时是否 HTTP 补报。
SDK_KAFKA_HTTP_FALLBACK_ENABLED=true
# KAFKA 模式必须修改：客户端可达 Kafka 地址。
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
# 可选：SDK Spring Kafka JSON 配置；无额外配置保持 {}。
KAFKA_SDK_APPLICATION_JSON={}

# ---------- 日志与资源 ----------
# 作用：HTTP runtime JVM 上限。
RUNTIME_HTTP_JAVA_TOOL_OPTIONS=-Xms128m -Xmx512m -XX:MaxMetaspaceSize=128m -XX:MaxDirectMemorySize=128m -XX:+ExitOnOutOfMemoryError
# 作用：SDK runtime JVM 上限。
RUNTIME_SDK_JAVA_TOOL_OPTIONS=-Xms128m -Xmx768m -XX:MaxMetaspaceSize=160m -XX:MaxDirectMemorySize=160m -XX:+ExitOnOutOfMemoryError
# 作用：Docker stdout 单文件轮转大小；可选：5m、10m、20m。
DOCKER_LOG_MAX_SIZE=10m
# 作用：Docker stdout 保留文件数；可选：2-10。
DOCKER_LOG_MAX_FILES=3
# 作用：runtime 日志级别；可选：ERROR、WARN、INFO、DEBUG，生产建议 WARN。
RUNTIME_LOG_LEVEL=WARN
# 作用：优雅停机等待时间；可选：30s-300s。
SHUTDOWN_TIMEOUT=120s
