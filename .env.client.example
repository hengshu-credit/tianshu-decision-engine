# 天枢客户端 runtime 配置
# 全新体验环境：复制 .env.client.example 为 .env.client，并同时复制服务端示例；客户端不直连 MySQL。
# Maven/JAR 读取工作目录及上级目录的 .env.client；同名配置以当前目录为准，环境变量和启动参数优先。
# 不读取 .env.server、旧 .env 或 .env.client.local；两端的 Redis 和鉴权配对信息须自行保持一致。
# 启动时用 --spring.profiles.active=http 或 sdk 选择运行时；默认 http，两者使用不同入口端口和令牌。
# Compose 使用 --env-file .env.client；合并服务端配置时先传 .env.client，后传 .env.server，同名项以后者为准。
# --env-file 不会自动把所有参数传进容器；仅源码/JAR使用的项需通过 override 的 environment 显式传入。
# 快速开始：先启动匹配的服务端，再通过 http/sdk profile 启动 runtime；默认使用已配对的 GLOBAL_KEY。
# 正式部署时须同步更换服务端公钥与本文件私钥、两端 Redis 密码，并重新生成 HTTP/SDK 入口令牌。
# 格式：每行 KEY=value；普通地址、数字、布尔值、单行 JSON 和 JVM 参数无需外层引号，空值写 KEY=。
# 值包含 #、字面量 $ 或需要保留首尾空格时才用单引号；不要写变量引用、跨行值或 shell 命令。
# 两个 example 已生成一套配对的试运行凭据；这些值随仓库公开，仅用于本地体验，正式部署前必须修改。

# ---------- Compose 项目与镜像（不影响 Maven/JAR） ----------
# Compose 项目名；与服务端分开部署时可使用不同名称，-p 参数可覆盖。
DEPLOY_PROJECT=tianshu-client
# Docker 网络名；通过容器名称直连 server/redis 时，必须加入其所在网络。
ENGINE_NETWORK=tianshu-client-engine
# runtime.jar 所在目录；相对路径以 Compose 文件所在目录解析。
RUNTIME_DIR=./runtime
# HTTP/SDK runtime 的 Java 运行镜像，须兼容 JDK 17。
JAVA_IMAGE=eclipse-temurin:17-jre-jammy

# ---------- 运行时端口 ----------
# 仅 Compose：宿主机绑定地址；0.0.0.0 所有网卡，127.0.0.1 仅本机。
APP_BIND_ADDRESS=0.0.0.0
# HTTP profile 的源码/JAR端口，也是 Compose 的宿主机映射端口；容器内固定 7070。
RUNTIME_HTTP_PORT=7070
# SDK profile 的源码/JAR端口，也是 Compose 的宿主机映射端口；容器内固定 7071。
RUNTIME_SDK_PORT=7071
# 源码/JAR 可用启动参数 --server.port 覆盖；不要在共享 .env.client 中固定 SERVER_PORT，以免两个 profile 冲突。
# RUNTIME_APP_NAME 可按实例通过环境变量设置；未设置时 http-runtime/sdk-runtime，Compose 分别为 runtime-http/runtime-sdk。

# ---------- 上游服务端与鉴权模式 ----------
# 服务端 HTTP(S) 根地址，不带 /api；源码同机可用 http://127.0.0.1:8080，远程填写实际 IP/域名。
# Docker Desktop 宿主机映射可用 host.docker.internal；容器里的 localhost 指向客户端自己。
# 同一 Docker 网络可用 http://server:8080；客户端必须能访问上游 readiness 接口。
RUNTIME_RULE_SERVER_URL=http://host.docker.internal:8080
# 支持 GLOBAL_KEY、LEGACY_TOKEN、BASIC、API_KEY、HMAC_SHA256；按所选模式填写下面对应凭据。
# GLOBAL_KEY 访问全部已发布项目，其余模式使用控制台中单个项目的调用凭据；与 runtime 入口令牌不同。
RULE_AUTH_TYPE=GLOBAL_KEY
# GLOBAL_KEY：与服务端 RULE_GLOBAL_ACCESS_KEY_ID 一致。
RULE_GLOBAL_KEY_ID=example-local
# GLOBAL_KEY：Ed25519 PKCS#8 DER 私钥的单行 Base64，须与服务端 X.509 公钥配对，不使用 PEM 多行格式。
RULE_GLOBAL_PRIVATE_KEY=MC4CAQAwBQYDK2VwBCIEIMo2v33+T0Os6n0VUIAIT7+n3PbUwwohSn2V4zOrtB+R
# LEGACY_TOKEN：项目兼容令牌；其他模式留空，不是 HTTP_ACCESS_TOKEN 或 SDK_ACCESS_TOKEN。
RUNTIME_PROJECT_ACCESS_TOKEN=
# 以下 BASIC/API_KEY/HMAC 参数由源码/JAR读取；Compose 使用这些模式需在两个 runtime 的 environment 中显式传入。
# BASIC：控制台项目调用鉴权的用户名，不是控制台登录账号。
RULE_USERNAME=
# BASIC：与项目调用用户名配套的密码。
RULE_PASSWORD=
# API_KEY：传递位置 HEADER 或 QUERY，必须与项目配置一致。
RULE_API_KEY_PLACEMENT=HEADER
# API_KEY：请求头或查询参数名称；大小写按项目配置填写。
RULE_API_KEY_NAME=X-Rule-Api-Key
# API_KEY：项目 API Key 的实际值。
RULE_API_KEY=
# HMAC_SHA256：项目 Access Key 标识。
RULE_ACCESS_KEY=
# HMAC_SHA256：项目 HMAC 签名密钥。
RULE_HMAC_SECRET=
# BASIC/API_KEY/HMAC_SHA256 是否先交换短期令牌；默认 true，false 使用原始项目凭据逐次认证。
RULE_TOKEN_EXCHANGE_ENABLED=true
# 非 GLOBAL_KEY 的 SDK 模式必须填写真实项目编码，用于 Redis 项目频道订阅；不是应用名称。
RUNTIME_RULE_PROJECT_CODE=
# 非 GLOBAL_KEY 的 SDK 模式必须填写真实项目 ID；HTTP 模式不要求，GLOBAL_KEY 常规 HTTP 日志模式可留空。
RUNTIME_RULE_PROJECT_ID=

# ---------- runtime 对外入口 ----------
# HTTP runtime 入口令牌，至少 32 字符；业务调用方需携带它，与上游项目凭据分别配置。
HTTP_ACCESS_TOKEN=101a13f00f1c540a63050da9fb836ad7d373bf0c6a8203584056da84b1b7182f
# SDK runtime 入口令牌，至少 32 字符；可与 HTTP 入口使用不同值。
SDK_ACCESS_TOKEN=0888387f51f5004b07bb5850ee49cf262491054e1437dacc5e2832caf878f008
# HTTP 入口允许调用的已发布规则编码，英文逗号分隔，大小写原样保留；项目模式必填。
# 当前 GLOBAL_KEY 模式不按该清单限制入口，可访问全部已发布项目；需要项目隔离时使用项目鉴权。
HTTP_RULE_ALLOWED_CODES=
# SDK 入口允许的已发布规则编码；项目模式必填且规则必须能本地执行，不能依赖服务端数据源能力。
SDK_RULE_ALLOWED_CODES=
# 是否生成执行追踪；false 减少追踪开销，true 用于排障/审计。
RUNTIME_TRACE_ENABLED=false
# 客户端到上游服务端的 HTTP 超时，单位毫秒，默认 30000。
RULE_HTTP_TIMEOUT_MS=30000
# 浏览器调用 runtime 时允许的来源模式，英文逗号分隔；包含协议和端口，不是上游服务端地址。
RUNTIME_CORS_ALLOWED_ORIGINS=http://localhost:9090

# ---------- Redis（仅 SDK；必须与 server 使用同一实例） ----------
# SDK 订阅规则/函数推送所用 Redis；HTTP profile 不连接 Redis，也不要求 Redis 可用。
# Docker Desktop 映射可用 host.docker.internal；full 模式覆盖主机为 redis，端口保持 6379。
REDIS_HOST=host.docker.internal
# SDK 可达的 Redis 端口；与服务端连接到同一实例即可，不要求两端地址文本相同。
REDIS_PORT=6379
# Redis database 编号，必须与服务端 REDIS_DATABASE 一致。
REDIS_DATABASE=0
# 必须与服务端同一 Redis 实例的密码一致。
REDIS_PASSWORD=c88ca5592174bf1b688f5f85387147679ee8dc51acf832580961e9f255c38b40

# ---------- SDK 缓存、日志上报与 Kafka ----------
# SDK 进程内 L1 规则缓存条数上限，不是 Redis 缓存大小。
SDK_CACHE_MAX_SIZE=1000
# 是否将 SDK 本地执行日志上报服务端。
SDK_LOG_REPORT_ENABLED=true
# 日志传输方式 HTTP 或 KAFKA；HTTP 默认，KAFKA 还需要 broker、主题/项目绑定和认证配置。
SDK_LOG_REPORT_TRANSPORT=HTTP
# KAFKA：执行日志主题，须在服务端 rule-engine.kafka.topic-projects 中绑定真实项目 ID。
# 当前 KAFKA 上报还须填写 RUNTIME_RULE_PROJECT_ID；GLOBAL_KEY 跨项目场景应使用 HTTP 上报。
SDK_KAFKA_LOG_TOPIC=rule-execution-log
# Kafka 发送失败时是否通过已鉴权 HTTP 补报，减少日志丢失。
SDK_KAFKA_HTTP_FALLBACK_ENABLED=true
# KAFKA：客户端可达的 broker 地址，可用英文逗号分隔；full 模式由 Compose 覆盖为 kafka:19092。
KAFKA_BOOTSTRAP_SERVERS=host.docker.internal:9092
# 仅 Compose：映射为 SPRING_APPLICATION_JSON，填写 Spring Kafka SASL/SSL 等配置，使用单行 JSON。
# 源码/JAR 需通过 SPRING_APPLICATION_JSON 环境变量或对应 Spring 参数传入，详见 docs/kafka-execution-logs.md。
KAFKA_SDK_APPLICATION_JSON={}

# ---------- Compose JVM 与日志 ----------
# 仅 Compose：HTTP runtime 的 JAVA_TOOL_OPTIONS；源码/JAR 需在 JVM 启动参数中设置，内部空格无需外层引号。
RUNTIME_HTTP_JAVA_TOOL_OPTIONS=-Xms128m -Xmx512m -XX:MaxMetaspaceSize=128m -XX:MaxDirectMemorySize=128m -XX:+ExitOnOutOfMemoryError
# 仅 Compose：SDK runtime 的 JAVA_TOOL_OPTIONS；内存还须覆盖规则缓存、模型和 native 分配。
RUNTIME_SDK_JAVA_TOOL_OPTIONS=-Xms128m -Xmx768m -XX:MaxMetaspaceSize=160m -XX:MaxDirectMemorySize=160m -XX:+ExitOnOutOfMemoryError
# Docker stdout 日志单文件大小，如 10m。
DOCKER_LOG_MAX_SIZE=10m
# Docker stdout 轮转文件保留数。
DOCKER_LOG_MAX_FILES=3
# 仅 Compose：根日志级别 TRACE/DEBUG/INFO/WARN/ERROR；源码/JAR 使用 logging.level.root 参数。
RUNTIME_LOG_LEVEL=WARN
# 源码/JAR 与 Compose：每个生命周期阶段的优雅停机等待时间；Compose 当前 stop_grace_period 为 180s。
SHUTDOWN_TIMEOUT=120s
