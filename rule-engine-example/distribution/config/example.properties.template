# 复制为 config/example.properties，或者通过进程环境变量注入。
# 不要把真实配置发给其他客户或提交到源码仓库。环境变量优先。
RULE_SERVER_URL=https://engine.example.com
RULE_CLIENT_APP_NAME=partner-risk-service
RULE_ALLOWED_CODES=YOUR_PUBLISHED_RULE
RULE_AUTH_TYPE=LEGACY_TOKEN
PROJECT_ACCESS_TOKEN=replace-with-project-token
RULE_HTTP_TIMEOUT_MS=10000
RULE_TRACE_ENABLED=false
# BASIC: RULE_USERNAME / RULE_PASSWORD
# API_KEY: RULE_API_KEY / RULE_API_KEY_NAME / RULE_API_KEY_PLACEMENT=HEADER
# HMAC_SHA256: RULE_ACCESS_KEY / RULE_HMAC_SECRET
# 非 LEGACY_TOKEN 默认换取临时 Token，可设 RULE_TOKEN_EXCHANGE_ENABLED=false 使用直接鉴权。
# EXAMPLE_BIND_ADDRESS=127.0.0.1
# EXAMPLE_PORT=7070
